NEXT_PUBLIC_SITE_URL=https://emranlabs.com
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-REPLACE_ME
NEXT_PUBLIC_META_PIXEL_ID=2306932560092203
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Optional event-specific Lead conversion ID from LinkedIn Campaign Manager.
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
# Set Clarity project Cookies OFF and Masking STRICT before configuring this ID.
# Cookieless collection still needs appropriate privacy disclosures and regional review.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Server-only OpenAI Responses API configuration for EM AI.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=replace-with-responses-api-model-id
AI_RATE_LIMIT_MAX=12
AI_RATE_LIMIT_WINDOW_MS=600000

# Server-only InMotion SMTP. Supply the mailbox password privately.
# Use the mail-server hostname: the website apex is Cloudflare-proxied.
CONTACT_SMTP_HOST=ded6959.inmotionhosting.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=helo@emranlabs.com
CONTACT_SMTP_PASSWORD=
CONTACT_TO_EMAIL=helo@emranlabs.com
CONTACT_FROM_EMAIL="EMRAN LABS <helo@emranlabs.com>"
# Optional override; blank uses the visitor's name for Reply-To.
CONTACT_REPLY_NAME=
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000

# Optional server-only Open-Meteo customer API key.
# Local evaluation works without it. Configure an eligible service plan before public commercial use.
OPEN_METEO_API_KEY=
