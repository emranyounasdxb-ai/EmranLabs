{
  "name": "emran-labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hosting": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:desktop": "node scripts/check-workspace.cjs",
    "check:email": "node scripts/verify-contact-smtp.mjs",
    "test:email": "node --test tests/email-confirmation.test.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "preview:email": "node scripts/render-email-previews.mjs",
    "test:browser": "playwright test",
    "test:visual": "playwright test visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test visual.spec.ts --project=chromium --update-snapshots",
    "test:performance": "playwright test performance.spec.ts --project=performance"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "14.6.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "openai": "7.44.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "corepack": "0.36.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
